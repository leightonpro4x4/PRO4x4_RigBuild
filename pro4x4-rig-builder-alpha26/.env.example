NODE_ENV=production
HOST=0.0.0.0
PORT=4180
PRO4X4_DB=/data/rigbuilder.sqlite
PRO4X4_PUBLIC_ORIGIN=https://rigbuilder.example.com
PRO4X4_TRUST_PROXY=true
PRO4X4_SECURE_COOKIES=true
PRO4X4_ALLOW_PROTOTYPE_HEADERS=false
PRO4X4_ALLOW_DEV_LOGIN=false
PRO4X4_SESSION_TTL_MINUTES=480
PRO4X4_REQUEST_BODY_LIMIT_BYTES=2000000
PRO4X4_BACKUP_BODY_LIMIT_BYTES=20000000
PRO4X4_RATE_LIMIT_WINDOW_MS=60000
PRO4X4_RATE_LIMIT_MAX=180
PRO4X4_AUTH_RATE_LIMIT_MAX=30

# Optional trusted staff identity gateway (reverse proxy / SSO bridge)
PRO4X4_AUTH_GATEWAY_ENABLED=false
PRO4X4_AUTH_GATEWAY_SECRET=replace-with-strong-shared-secret
PRO4X4_AUTH_GATEWAY_EMAIL_DOMAIN=pro4x4.com.au
PRO4X4_AUTH_GATEWAY_MAX_SKEW_SECONDS=60

# Prometheus-style metrics
PRO4X4_METRICS_ENABLED=true
PRO4X4_METRICS_TOKEN=replace-with-monitoring-bearer-token

# Alpha 16 governed render binary vault
PRO4X4_ASSET_VAULT=./runtime/asset-vault
PRO4X4_ASSET_BODY_LIMIT_BYTES=25000000

# Alpha 19 governed render asset storage
PRO4X4_ASSET_STORAGE_DRIVER=local
PRO4X4_ASSET_VAULT=./runtime/asset-vault
# S3-compatible mode (AWS S3 / R2 / MinIO / compatible object stores)
# PRO4X4_ASSET_STORAGE_DRIVER=s3
# PRO4X4_ASSET_S3_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
# PRO4X4_ASSET_S3_BUCKET=pro4x4-rig-assets
# PRO4X4_ASSET_S3_REGION=ap-southeast-2
# PRO4X4_ASSET_S3_ACCESS_KEY_ID=
# PRO4X4_ASSET_S3_SECRET_ACCESS_KEY=
# PRO4X4_ASSET_S3_SESSION_TOKEN=
# PRO4X4_ASSET_S3_FORCE_PATH_STYLE=false
# Optional immutable production-layer CDN origin. Only production-ready assets redirect here.
# PRO4X4_ASSET_CDN_BASE_URL=https://rig-assets.pro4x4.com.au
# Historical staff retrieval links expire quickly.
PRO4X4_ASSET_SIGNED_URL_TTL_SECONDS=300
# Set explicitly in persistent production deployments; 32+ characters.
# PRO4X4_ASSET_DELIVERY_SECRET=
