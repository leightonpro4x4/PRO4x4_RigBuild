{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro4x4.com.au/schemas/seed-bundle-0.12.0.json",
  "title": "PRO4X4 Rig Builder Bootstrap Seed v0.12.0",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "description", "catalogue", "quotes", "projectSnapshots"],
  "properties": {
    "schemaVersion": {"const": "0.12.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "description": {"type": "string"},
    "catalogue": {
      "type": "object",
      "required": ["schemaVersion", "vehicleId", "vehicle", "accessories", "revision"],
      "properties": {
        "schemaVersion": {"const": "0.12.0"},
        "vehicleId": {"type": "string"},
        "vehicle": {"type": "object"},
        "accessories": {"type": "array", "minItems": 1},
        "revision": {"type": "string"}
      }
    },
    "quotes": {"type": "array"},
    "projectSnapshots": {"type": "array"}
  }
}
