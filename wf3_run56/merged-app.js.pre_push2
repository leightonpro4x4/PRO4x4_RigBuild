(()=> {
const vehicles={y62:{label:'2025 NISSAN PATROL Y62 WARRIOR',sub:'VISUAL PROOF VEHICLE',data:window.RIG_DATA},ranger:{label:'2025 FORD RANGER NEXT-GEN',sub:'CATALOGUE + FITMENT PROOF VEHICLE',data:window.RANGER_DATA}};
const backend=window.PRO4X4_BACKEND.active(), contract=window.PRO4X4_MERGED_PROJECT, manifest=window.Y62_RENDER_MANIFEST;
window.PRO4X4_PRODUCT_VISUALS?.applyDataset?.(window.RIG_DATA);window.PRO4X4_PRODUCT_VISUALS?.applyDataset?.(window.RANGER_DATA);
let state={vehicle:'ranger',category:'ALL',selected:new Set(),history:[],redo:[],projectId:null,projectRecord:null,revisionId:null,reference:null,renderResolution:null,renderRequest:0,quoteQueued:false};
const $=s=>document.querySelector(s), money=n=>new Intl.NumberFormat('en-AU',{style:'currency',currency:'AUD',maximumFractionDigits:0}).format(n||0);
const current=()=>vehicles[state.vehicle].data, products=()=>current().accessories||[], selectedProducts=()=>products().filter(p=>state.selected.has(p.id));
const norm=p=>contract.normalizedPricing(p), snap=()=>({vehicle:state.vehicle,selected:[...state.selected]});
function pushHistory(){state.history.push(snap());if(state.history.length>40)state.history.shift();state.redo=[]}
function applySnap(s){state.vehicle=s.vehicle;state.selected=new Set(s.selected);state.category='ALL';render();refreshRenderResolution()}
function clearProjectContext(){state.projectId=null;state.projectRecord=null;state.revisionId=null;state.reference=null;state.quoteQueued=false;syncProjectChip()}
function setVehicle(k){if(k===state.vehicle)return;pushHistory();state.vehicle=k;state.selected.clear();state.category='ALL';clearProjectContext();render();refreshRenderResolution()}
function productRequires(p){return p.requires||p.fitment?.requiredParts||[]}
function toggle(id){pushHistory();const p=products().find(x=>x.id===id);if(!p)return;if(state.selected.has(id)){state.selected.delete(id);products().filter(x=>productRequires(x).includes(id)).forEach(x=>state.selected.delete(x.id));}else{if(p.group)products().filter(x=>x.group===p.group&&x.id!==p.id).forEach(x=>state.selected.delete(x.id));productRequires(p).forEach(req=>{if(products().some(x=>x.id===req))state.selected.add(req)});state.selected.add(id);}state.quoteQueued=false;render();refreshRenderResolution()}
function status(p){if(p.status==='blocked')return['BLOCKED','bad'];if(p.status==='engineering'||p.fitment?.reviewRequired)return['FITMENT MAPPING','warn'];return['CONFIRMED','good']}
function y62Requirements(){if(state.vehicle!=='y62'||!manifest?.views?.front34)return[];const selectedLayers=new Set(selectedProducts().map(a=>a.layer));return [...manifest.views.front34.layers].sort((a,b)=>a.priority-b.priority).filter(layer=>layer.id==='base'||layer.id==='wheels'||selectedLayers.has(layer.id)||selectedLayers.has(layer.id.replace(/-(wheel|jerry|camera)$/,''))).map(layer=>{if(layer.id==='base')return {layerId:layer.id,exactSku:layer.exactSku??null,state:{paintId:current().vehicle.paints?.[0]?.id||'black-obsidian'},stateKey:`paint:${current().vehicle.paints?.[0]?.id||'black-obsidian'}`};if(layer.id==='wheels')return {layerId:layer.id,exactSku:layer.exactSku??null,state:{wheelTyreId:current().vehicle.wheelTyres?.[0]?.id||'factory-warrior'},stateKey:`wheel:${current().vehicle.wheelTyres?.[0]?.id||'factory-warrior'}`};return {layerId:layer.id,exactSku:layer.exactSku??null,state:{},stateKey:null}})}
async function refreshRenderResolution(){const req=++state.renderRequest;if(state.vehicle!=='y62'){state.renderResolution=null;renderVisual();return}try{const r=await backend.resolveRenderStack({vehicleId:current().vehicle.id,viewId:'front34',requirements:y62Requirements()});if(req!==state.renderRequest)return;state.renderResolution=r;renderVisual()}catch(e){if(req!==state.renderRequest)return;state.renderResolution={productionReady:false,counts:{available:0,missing:y62Requirements().length,blocked:0},layers:[],error:e.message};renderVisual()}}
function renderVisual(){const h=$('#heroVisual');if(!h)return;const y=state.vehicle==='y62',r=state.renderResolution,c=r?.counts||{available:0,missing:y?y62Requirements().length:0,blocked:0};h.innerHTML=`<div class="merge-visual-mark"><span>${y?'Y62':'RANGER'}</span><b>${r?.productionReady?'EXACT PRODUCTION STACK READY':'PRODUCTION VISUAL PENDING'}</b><small>${y?`Server-governed Y62-F34-V1 resolver · ${c.available||0} available / ${c.missing||0} missing / ${c.blocked||0} blocked. No reference or approximate layer is shown.`:'Ranger catalogue + fitment branch is live. Production render layers remain unapproved, so no stand-in vehicle artwork is shown.'}</small></div>`}
function renderVehicle(){const v=current().vehicle,m=vehicles[state.vehicle];$('#vehicleTitle').textContent=m.label;$('#vehicleSub').textContent=m.sub;$('#vehicleName').textContent=`${v.yearRange||''} ${v.make} ${v.model}`.trim();$('#vehicleType').textContent=`${v.trim||v.bodyStyle||''} · ${v.drivetrain||'4WD'}`;document.querySelectorAll('[data-vehicle]').forEach(b=>b.classList.toggle('active',b.dataset.vehicle===state.vehicle));renderVisual()}
function renderCategories(){const cats=['ALL',...new Set(products().map(p=>(p.category||'OTHER').toUpperCase()))],h=$('#categoryTabs');h.innerHTML='';cats.forEach(c=>{const b=document.createElement('button');b.className=c===state.category?'active':'';b.textContent=c;b.onclick=()=>{state.category=c;renderCategories();renderProducts()};h.appendChild(b)})}
function renderProducts(){
  const ps=products().filter(p=>state.category==='ALL'||(p.category||'').toUpperCase()===state.category),visuals=window.PRO4X4_PRODUCT_VISUALS;
  $('#productCount').textContent=`${ps.length} PRODUCTS`;
  const g=$('#mergedProducts');g.innerHTML='';
  const brands=[...new Set(ps.map(p=>p.brand||'OTHER'))].sort((a,b)=>a.localeCompare(b));
  brands.forEach((brand,brandIndex)=>{
    const group=document.createElement('details');group.className='merge-vendor';group.open=brands.length===1||brandIndex===0;
    const items=ps.filter(p=>(p.brand||'OTHER')===brand);
    group.innerHTML=`<summary><span>${brand}</span><b>${items.length} PRODUCT${items.length===1?'':'S'}</b></summary><div class="merge-vendor-products"></div>`;
    const host=group.querySelector('.merge-vendor-products');
    items.forEach(p=>{
      const [st,cls]=status(p),pr=norm(p),added=state.selected.has(p.id),visual=visuals?.badge(p,current().vehicle.id)||{label:'PRICED / PREVIEW PENDING',className:'neutral'},messages=visuals?.preAddMessages(p,products(),state.selected)||[],d=document.createElement('article');
      d.className='merge-product'+(added?' added':'');
      d.innerHTML=`<div class="mp-top"><span>${p.brand}</span><span class="fit ${cls}">${st}</span></div><div class="mp-visual fit ${visual.className}">${visual.label}</div><h3>${p.name}</h3><p>${p.note||''}</p>${messages.length?`<div class="mp-requirements">${messages.map(x=>`<span>${x}</span>`).join('')}</div>`:''}<div class="mp-meta"><span>${p.weightKg==null?'WEIGHT TBC':p.weightKg+' KG'}</span><span>${p.sku}</span></div><div class="mp-price"><div><b>${money(pr.parts)}</b><small>${pr.labour!=null?` + ${money(pr.labour)} install`:' + INSTALL QUOTE'}</small></div><button>${added?'REMOVE':'ADD'}</button></div>`;
      d.querySelector('button').onclick=()=>toggle(p.id);host.appendChild(d);
    });
    g.appendChild(group);
  });
}
function renderBuild(){const sel=selectedProducts(),h=$('#mergedBuild');h.innerHTML='';let parts=0,labour=0,kg=0,unknown=0,review=0;sel.forEach(p=>{const pr=norm(p);parts+=Number(pr.parts)||0;labour+=Number(pr.labour)||0;if(p.weightKg==null)unknown++;else kg+=p.weightKg;if(p.status!=='confirmed'||p.fitment?.reviewRequired)review++;const r=document.createElement('div');r.className='merge-build-row';r.innerHTML=`<div><b>${p.name}</b><span>${p.brand} · ${p.sku}</span></div><strong>${money((Number(pr.parts)||0)+(Number(pr.labour)||0))}</strong><button>×</button>`;r.querySelector('button').onclick=()=>toggle(p.id);h.appendChild(r)});$('#selectedCount').textContent=sel.length;$('#partsTotal').textContent=money(parts);$('#fittedTotal').textContent=money(parts+labour);$('#weightTotal').textContent=kg+' KG'+(unknown?` + ${unknown} TBC`:'');$('#reviewTotal').textContent=review;const f=$('#fitmentBanner');f.textContent=review?`${review} SELECTED ITEM${review>1?'S':''} REQUIRE PRO4X4 FITMENT REVIEW`:'ALL SELECTED PARTS COMPATIBLE / NO OPEN REVIEW GATES';f.className='fitment-banner '+(review?'warn':'good')}
function leadFromForm(){return {name:$('#leadName')?.value.trim()||'',phone:$('#leadPhone')?.value.trim()||'',email:$('#leadEmail')?.value.trim()||'',postcode:$('#leadPostcode')?.value.trim()||'',preferredContact:'phone',notes:$('#leadNotes')?.value.trim()||''}}
function applyLead(lead={}){[['leadName','name'],['leadPhone','phone'],['leadEmail','email'],['leadPostcode','postcode'],['leadNotes','notes']].forEach(([id,k])=>{const el=$('#'+id);if(el)el.value=lead[k]||''})}
function makeProjectId(){const a=new Uint8Array(6);crypto.getRandomValues(a);return `P4X4-PROJ-${new Date().toISOString().slice(0,10).replaceAll('-','')}-${[...a].map(x=>x.toString(16).padStart(2,'0')).join('').slice(0,8).toUpperCase()}`}
function projectRevision(p,rid){return p?.revisions?.find(r=>r.id===rid)||p?.revisions?.find(r=>r.id===p.currentRevisionId)||p?.revisions?.at(-1)||null}
function syncProjectChip(){const box=$('#projectChip'),share=$('#shareMerged');if(!box)return;if(!state.projectRecord){box.className='merge-project-chip';box.innerHTML='<span>PROJECT</span><b>UNSAVED BUILD</b><small>No sales submission yet</small>';if(share)share.disabled=true;return}const r=projectRevision(state.projectRecord,state.revisionId);box.className='merge-project-chip '+(state.quoteQueued?'queued':'saved');box.innerHTML=`<span>PROJECT</span><b>${state.projectRecord.id}</b><small>${r?.id||state.revisionId||'—'} · ${state.quoteQueued?'IN STAFF SALES QUEUE':'SAVED IMMUTABLE REVISION'}</small>`;if(share)share.disabled=false}
function buildPayload(){return contract.buildSnapshot({data:current(),selectedProducts:selectedProducts(),lead:leadFromForm(),reference:state.reference||undefined,paintId:current().vehicle.paints?.[0]?.id||null,wheelTyreId:current().vehicle.wheelTyres?.[0]?.id||null,view:'front34',renderResolution:state.renderResolution})}
async function saveProject(source='merged-customer-builder'){const payload=buildPayload();state.reference=payload.reference;const id=state.projectId||makeProjectId(),expectedVersion=state.projectRecord?.version??0,title=contract.projectTitle(payload);const saved=await backend.saveProjectRevision(id,payload,{source,expectedVersion,title});state.projectId=saved.project.id;state.projectRecord=saved.project;state.revisionId=saved.revision.id;state.reference=saved.snapshot.reference;localStorage.setItem('pro4x4-merged-last-build',JSON.stringify(saved.snapshot));history.replaceState(null,'',`index.html?project=${encodeURIComponent(state.projectId)}&revision=${encodeURIComponent(state.revisionId)}`);syncProjectChip();return saved.snapshot}
async function saveBuild(){const b=$('#saveMerged');b.disabled=true;try{const payload=await saveProject('merged-customer-builder');$('#mergeNotice').innerHTML=`Saved <b>${payload.project.id}</b> revision <b>${payload.project.revisionId}</b> through <b>${backend.mode}</b>. This does not enter the sales queue.`;return payload}catch(e){$('#mergeNotice').textContent=e.code==='VERSION_CONFLICT'||e.code==='version_conflict'?`Project changed elsewhere (version ${e.currentVersion??'unknown'}). Reload before saving another revision.`:`Build save failed: ${e.message}`;return null}finally{b.disabled=false}}
async function requestQuote(){const lead=leadFromForm();if(!lead.name||(!lead.phone&&!lead.email)){$('#mergeNotice').textContent='Quote request needs your name plus a phone number or email. You can still use SAVE BUILD without contact details.';return}const b=$('#quoteMerged');b.disabled=true;b.textContent='SAVING + SENDING…';try{const payload=await saveProject('merged-sales-queue-submit');const queued=await backend.createBuild(payload);state.quoteQueued=true;syncProjectChip();$('#mergeNotice').innerHTML=`Build <b>${queued.reference}</b> is in the PRO4X4 staff queue as <b>${String(queued.workflow?.status||'new').replaceAll('-',' ').toUpperCase()}</b>. The exact saved revision remains linked to this quote.`}catch(e){$('#mergeNotice').textContent=`Quote request failed: ${e.message}. ${state.projectId?'Your saved project revision remains intact.':''}`}finally{b.disabled=false;b.textContent='SAVE + REQUEST A QUOTE →'}}
async function shareBuild(){if(!state.projectId)return;const b=$('#shareMerged');b.disabled=true;try{const share=await backend.createProjectShare(state.projectId,{role:'customer-view',revisionId:state.revisionId,expiresDays:30});state.projectRecord=await backend.getProject(state.projectId);const url=new URL('share.html',location.href);url.searchParams.set('token',share.token);if(navigator.clipboard?.writeText)await navigator.clipboard.writeText(url.href);else prompt('Copy share link',url.href);$('#mergeNotice').innerHTML=`Customer view link created for <b>${state.revisionId}</b>${navigator.clipboard?.writeText?' and copied to clipboard':''}.`}catch(e){$('#mergeNotice').textContent=`Share link failed: ${e.message}`}finally{b.disabled=false}}
function applySnapshot(x){if(!x?.vehicle?.id)return;const k=x.vehicle.id===vehicles.y62.data.vehicle.id?'y62':x.vehicle.id===vehicles.ranger.data.vehicle.id?'ranger':null;if(!k)throw new Error(`Unsupported vehicle ${x.vehicle.id}`);state.vehicle=k;state.selected=new Set((x.selections||[]).map(a=>a.id).filter(id=>vehicles[k].data.accessories.some(p=>p.id===id)));state.reference=x.reference||null;state.category='ALL';applyLead(x.lead||{});render()}
async function loadRequestedProject(){const q=new URLSearchParams(location.search),pid=q.get('project'),rid=q.get('revision');if(!pid)return;try{const p=await backend.getProject(pid),r=projectRevision(p,rid||p.currentRevisionId);if(!r)throw new Error('Project revision not found');state.projectId=p.id;state.projectRecord=p;state.revisionId=r.id;applySnapshot(r.snapshot);syncProjectChip();await refreshRenderResolution();$('#mergeNotice').innerHTML=`Loaded <b>${p.id}</b> revision <b>${r.id}</b> from <b>${backend.mode}</b>. Saving creates another immutable revision.`}catch(e){$('#mergeNotice').textContent=`Saved project could not be loaded: ${e.message}`}}
function render(){renderVehicle();renderCategories();renderProducts();renderBuild();syncProjectChip();$('#undo').disabled=!state.history.length;$('#redo').disabled=!state.redo.length}
document.querySelectorAll('[data-vehicle]').forEach(b=>b.onclick=()=>setVehicle(b.dataset.vehicle));$('#undo').onclick=()=>{if(!state.history.length)return;state.redo.push(snap());applySnap(state.history.pop())};$('#redo').onclick=()=>{if(!state.redo.length)return;state.history.push(snap());applySnap(state.redo.pop())};$('#clearBuild').onclick=()=>{pushHistory();state.selected.clear();state.quoteQueued=false;render();refreshRenderResolution()};$('#saveMerged').onclick=saveBuild;$('#quoteMerged').onclick=requestQuote;$('#shareMerged').onclick=shareBuild;
render();loadRequestedProject().then(()=>refreshRenderResolution());
})();
