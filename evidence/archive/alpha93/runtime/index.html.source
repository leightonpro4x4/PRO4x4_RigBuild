<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>PRO4X4 Alpha 87</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#090e11;color:#edf1f2;font-family:Arial,sans-serif}header{padding:16px 14px;background:#070a0c;border-bottom:2px solid #f56622}header b{font-size:20px}header small{display:block;color:#f58a55;font-size:9px;letter-spacing:1px;margin-top:4px}.wrap{max-width:1100px;margin:auto;padding:10px}.note{padding:10px;border:1px solid #365047;background:#0d1514;color:#a9e8cd;font-size:10px;line-height:1.45}.stage{height:47vh;min-height:330px;margin-top:10px;background:radial-gradient(circle,#354249,#12191d 62%,#070b0d);border:1px solid #39464d;position:relative;touch-action:none}.stage canvas{width:100%;height:100%;display:block}.badge,.status{position:absolute;z-index:3;top:10px;padding:7px;background:#071014dd;font-size:8px}.badge{left:10px;border:1px solid #f56622}.status{right:10px;border:1px solid #46565d;color:#8ee3bf}.toolbar{display:flex;gap:7px;flex-wrap:wrap;margin:9px 0}.toolbar button{padding:10px;background:#141c20;color:#fff;border:1px solid #3b484f;font-weight:800}.toolbar .primary{background:#f56622;color:#090b0c;border-color:#f56622}.summary{display:flex;gap:6px;flex-wrap:wrap;margin:9px 0 14px}.summary span{padding:7px 9px;border:1px solid #344047;font-size:8px}.cat{border:1px solid #303b41}.cat>button,.vendor>button{width:100%;border:0;background:#11181c;color:#fff;padding:13px;text-align:left;display:flex;justify-content:space-between;font-weight:800}.vendor{border-top:1px solid #263138}.vendor>button{background:#0d1316;padding-left:22px}.products{padding:9px}.card{border:1px solid #42544d;background:#12191d;padding:12px}.card small{color:#7ee0b6;font-weight:900}.card h3{font-size:15px}.card p{font-size:10px;color:#aeb8bd;line-height:1.5}.price{font-size:19px;font-weight:900;margin:10px 0}.add{width:100%;padding:12px;background:#f56622;color:#090b0c;border:1px solid #f56622;font-weight:900}.add.on{background:#1c2b25;color:#8ce2bc;border-color:#65d5a6}.hidden{display:none}.quote{margin:16px 0 40px;padding:14px;background:#0d1417;border:1px solid #39464d}.qhead{display:flex;justify-content:space-between;border-bottom:1px solid #2d383e;padding-bottom:10px}.qhead span{color:#f58a55;font-size:9px}.kpis{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid #2d383e;margin:10px 0}.kpis div{padding:10px;border-right:1px solid #2d383e}.kpis span{display:block;color:#87949a;font-size:8px}.kpis b{display:block;margin-top:5px}.form{display:grid;grid-template-columns:1fr 1fr;gap:8px}.quote label{display:block;color:#8f9ba0;font-size:8px;margin:7px 0}.quote input,.quote textarea{width:100%;margin-top:5px;background:#090e10;color:#fff;border:1px solid #354249;padding:11px}.submit{width:100%;margin-top:10px;padding:13px;background:#f56622;border:0;font-weight:900}.result{margin-top:8px;padding:9px;border:1px solid #39464d;color:#aeb8bd;font-size:9px}.good{border-color:#65d5a6;color:#8be4be}@media(max-width:600px){.stage{height:40vh;min-height:290px}.form,.kpis{grid-template-columns:1fr}.kpis div{border-right:0;border-bottom:1px solid #2d383e}}
</style><script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"}}</script></head>
<body><header><b>PRO4X4 RIG BUILDER</b><small>ALPHA 93 · FIRST REAL ACCESSORY FITMENT</small></header><div class="wrap">
<div class="note"><b>REAL SCENE:</b> canonical-derived Ranger + governed Predator V3 mesh. No block vehicle and no photo-overlay substitute.</div>
<div class="stage" id="stage"><div class="badge">REAL RANGER · LIVE 3D · DRAG / PINCH</div><div class="status" id="status">LOADING…</div></div>
<div class="toolbar"><button class="primary" id="togglePred">ADD PREDATOR</button><button id="toggleRally">ADD RALLY HOOP</button><button id="toggleLights">ADD BUTT KICKER PAIR</button><button id="toggleScout">ADD SCOUT ROOF RACK</button><button id="togglePowerboards">ADD POWER BOARDS</button><button id="toggleTubrack">ADD NICE TUB RACK</button><button id="toggleRearbumper">ADD REAR BUMPER</button><button id="loadFullBuild">LOAD FULL $10,239 BUILD</button><button id="resetBuild">RESET BUILD</button><button id="resetView">RESET VIEW</button><button id="front">FRONT</button><button id="threeq">3/4 VIEW</button></div><div class="summary"><span id="runtimeGate">RUNTIME CHECK · WAITING</span><span id="count">0 PRODUCTS</span><span id="total">$0 PARTS</span><span>PREDATOR · VISUAL REPLICA QA</span></div>
<section class="cat"><button id="cat"><span>FRONT PROTECTION + LIGHTING</span><span>3 PRODUCTS · 3 IN 3D</span></button><div id="catBody"><div class="vendor"><button id="vendor"><span>OFFROAD ANIMAL</span><span>3 VIEW IN 3D</span></button><div id="vendorBody" class="products">
<article class="card"><small>3D · FRONT · QA</small><h3>Predator Bull Bar — Ranger Next Gen</h3><p>SKU FB-FRA-NG-22-PR-ASM0</p><div class="price">$3,100</div><button class="add" id="cardPred">ADD + VIEW IN 3D</button></article>
<article class="card"><small>3D · FRONT POD · QA</small><h3>Rally Hoop to suit Butt Kicker 7in Lights</h3><p>SKU TB-COM-RAL-ORA-2X7-ASM0 · Requires Predator</p><div class="price">$315</div><button class="add" id="cardRally">ADD + VIEW IN 3D</button></article>
<article class="card"><small>3D · LIGHTING · QA</small><h3>Butt Kicker 7in LED Driving Lights — Pair</h3><p>SKU ORA-ALO-R5-C10D1 · Requires Rally Hoop + Predator</p><div class="price">$415</div><button class="add" id="cardLights">ADD + VIEW IN 3D</button></article>
</div></div></div></section>
<section class="cat"><button id="touringCat"><span>TOURING + ROOF STORAGE</span><span>1 PRODUCT · 1 IN 3D</span></button><div id="touringBody"><div class="vendor"><button id="touringVendor"><span>OFFROAD ANIMAL</span><span>1 VIEW IN 3D</span></button><div id="touringVendorBody" class="products"><article class="card"><small>3D · ROOF · QA</small><h3>Scout Roof Rack — Next Gen Ranger 2022 to current</h3><p>SKU RR-FRA-PU-22-SCT-ASM0 · Independent roof-zone accessory</p><div class="price">$1,520</div><button class="add" id="cardScout">ADD + VIEW IN 3D</button></article></div></div></div></section>
<section class="cat"><button id="sideCat"><span>SIDE STEPS + ACCESS</span><span>1 PRODUCT · 1 IN 3D</span></button><div id="sideBody"><div class="vendor"><button id="sideVendor"><span>CLEARVIEW</span><span>1 VIEW IN 3D</span></button><div id="sideVendorBody" class="products"><article class="card"><small>3D · SIDE · QA</small><h3>Power Boards [Pair] — Ford NG Ranger Dual Cab 2022 on</h3><p>SKU PB-FD-005 · Retractable electric side steps</p><div class="price">$1,649</div><button class="add" id="cardPowerboards">ADD + VIEW IN 3D</button></article></div></div></div></section>
<section class="cat"><button id="tubCat"><span>TUB + LOAD CARRYING</span><span>1 PRODUCT · 1 IN 3D</span></button><div id="tubBody"><div class="vendor"><button id="tubVendor"><span>OFFROAD ANIMAL</span><span>1 VIEW IN 3D</span></button><div id="tubVendorBody" class="products"><article class="card"><small>3D · TUB · QA</small><h3>The Nice Tub Rack — Universal Fit</h3><p>SKU TR-NR-COM-ASM1 · Adjustable-height tub rack</p><div class="price">$1,300</div><button class="add" id="cardTubrack">ADD + VIEW IN 3D</button></article></div></div></div></section>
<section class="cat"><button id="rearCat"><span>REAR PROTECTION</span><span>1 PRODUCT · 1 IN 3D</span></button><div id="rearBody"><div class="vendor"><button id="rearVendor"><span>OFFROAD ANIMAL</span><span>1 VIEW IN 3D</span></button><div id="rearVendorBody" class="products"><article class="card"><small>3D · REAR · QA</small><h3>Rear Protection Bumper — Ford Ranger RA Next Gen 2022 on</h3><p>SKU RB-FRA-NG-22-ASM0 · Requires factory towbar for fitment</p><div class="price">$1,940</div><button class="add" id="cardRearbumper">ADD + VIEW IN 3D</button></article></div></div></div></section>
<section class="cat"><button id="testCat"><span>ALPHA 93 TEST CHECKLIST</span><span>iPHONE REGRESSION</span></button><div id="testBody"><div class="products"><article class="card"><small>TEST IN THIS ORDER</small><p>1. Rotate and pinch the stock Ranger.<br>2. Add Predator — factory front must disappear.<br>3. Add Rally, then Butt Kickers.<br>4. Add Scout, Power Boards and Nice Tub Rack.<br>5. Add Rear Bumper — factory rear must disappear.<br>6. Confirm $10,239 parts total.<br>7. Remove Predator — Rally and lights must also disappear.<br>8. Remove Rear Bumper — factory rear must return.<br>9. Reload Safari — build should persist.<br>10. Submit a QA quote and confirm exact selected items.</p></article></div></div></section>
<section class="quote"><div class="qhead"><span>YOUR BUILD</span><b id="build">STOCK RANGER</b></div><div id="quoteLines" style="font-size:10px;line-height:1.6;color:#b8c1c5;margin:10px 0"></div><div class="kpis"><div><span>PARTS TOTAL</span><b id="qparts">$0</b></div><div><span>INSTALL</span><b>QUOTE REQUIRED</b></div><div><span>FITTED EST.</span><b id="fitted">$0</b></div></div>
<div class="form"><label>NAME<input id="name" placeholder="Your name"></label><label>PHONE<input id="phone" placeholder="04xx xxx xxx"></label><label>EMAIL<input id="email" placeholder="name@example.com"></label><label>POSTCODE<input id="postcode" placeholder="5014"></label></div><label>BUILD NOTES<textarea id="notes" rows="3"></textarea></label><button class="submit" id="quote">REQUEST A QUOTE →</button><div class="result" id="result">QA MODE · quote snapshot is stored locally; production delivery is not connected in this temporary build.</div></section></div>
<script>
const PRODUCTS={predator:{name:'Predator Bull Bar',sku:'FB-FRA-NG-22-PR-ASM0',price:3100,requires:[]},rally:{name:'Rally Hoop',sku:'TB-COM-RAL-ORA-2X7-ASM0',price:315,requires:['predator']},lights:{name:'Butt Kicker 7in Pair',sku:'ORA-ALO-R5-C10D1',price:415,requires:['predator','rally']},scout:{name:'Scout Roof Rack',sku:'RR-FRA-PU-22-SCT-ASM0',price:1520,requires:[]},powerboards:{name:'Clearview Power Boards',sku:'PB-FD-005',price:1649,requires:[]},tubrack:{name:'The Nice Tub Rack',sku:'TR-NR-COM-ASM1',price:1300,requires:[]},rearbumper:{name:'Rear Protection Bumper',sku:'RB-FRA-NG-22-ASM0',price:1940,requires:[]}};
let selected=new Set(JSON.parse(localStorage.getItem('p4x4-a87')||'[]'));
function add(id){PRODUCTS[id].requires.forEach(r=>selected.add(r));selected.add(id);sync()}
function remove(id){selected.delete(id);let again=true;while(again){again=false;for(const [k,v] of Object.entries(PRODUCTS))if(selected.has(k)&&v.requires.some(r=>!selected.has(r))){selected.delete(k);again=true}}sync()}
function toggle(id){selected.has(id)?remove(id):add(id)}
function sync(){localStorage.setItem('p4x4-a87',JSON.stringify([...selected]));const chosen=Object.entries(PRODUCTS).filter(([id])=>selected.has(id)),sum=chosen.reduce((a,[,p])=>a+p.price,0);count.textContent=chosen.length+' PRODUCT'+(chosen.length===1?'':'S');total.textContent='$'+sum.toLocaleString()+' PARTS';qparts.textContent='$'+sum.toLocaleString();fitted.textContent=chosen.length?'$'+sum.toLocaleString()+' + INSTALL':'$0';build.textContent=chosen.length?'RANGER · '+chosen.length+' ITEMS':'STOCK RANGER';quoteLines.innerHTML=chosen.map(([,p])=>`<div>${p.name}<b style="float:right">$${p.price.toLocaleString()}</b></div>`).join('')||'No products selected.';const ui={predator:['Pred','PREDATOR'],rally:['Rally','RALLY HOOP'],lights:['Lights','BUTT KICKER PAIR'],scout:['Scout','SCOUT ROOF RACK'],powerboards:['Powerboards','POWER BOARDS'],tubrack:['Tubrack','NICE TUB RACK'],rearbumper:['Rearbumper','REAR BUMPER']};for(const id of Object.keys(PRODUCTS)){const on=selected.has(id),[suffix,label]=ui[id],tb=document.getElementById('toggle'+suffix),card=document.getElementById('card'+suffix);if(tb)tb.textContent=(on?'REMOVE ':'ADD ')+label;if(card){card.textContent=on?'REMOVE':'ADD + VIEW IN 3D';card.classList.toggle('on',on)}}window.dispatchEvent(new CustomEvent('rigchange',{detail:[...selected]}))}
togglePred.onclick=()=>toggle('predator');toggleRally.onclick=()=>toggle('rally');toggleLights.onclick=()=>toggle('lights');toggleScout.onclick=()=>toggle('scout');togglePowerboards.onclick=()=>toggle('powerboards');toggleTubrack.onclick=()=>toggle('tubrack');toggleRearbumper.onclick=()=>toggle('rearbumper');cardScout.onclick=()=>toggle('scout');cardPowerboards.onclick=()=>toggle('powerboards');cardTubrack.onclick=()=>toggle('tubrack');cardRearbumper.onclick=()=>toggle('rearbumper');rearCat.onclick=()=>rearBody.classList.toggle('hidden');rearVendor.onclick=()=>rearVendorBody.classList.toggle('hidden');testCat.onclick=()=>testBody.classList.toggle('hidden');tubCat.onclick=()=>tubBody.classList.toggle('hidden');tubVendor.onclick=()=>tubVendorBody.classList.toggle('hidden');sideCat.onclick=()=>sideBody.classList.toggle('hidden');sideVendor.onclick=()=>sideVendorBody.classList.toggle('hidden');touringCat.onclick=()=>touringBody.classList.toggle('hidden');touringVendor.onclick=()=>touringVendorBody.classList.toggle('hidden');cardPred.onclick=()=>toggle('predator');cardRally.onclick=()=>toggle('rally');cardLights.onclick=()=>toggle('lights');resetView.onclick=()=>window.dispatchEvent(new Event('resetview'));front.onclick=()=>window.dispatchEvent(new CustomEvent('setview',{detail:'front'}));threeq.onclick=()=>window.dispatchEvent(new CustomEvent('setview',{detail:'3q'}));loadFullBuild.onclick=()=>{selected=new Set(Object.keys(PRODUCTS));sync()};resetBuild.onclick=()=>{selected.clear();sync()};
quote.onclick=()=>{const chosen=Object.entries(PRODUCTS).filter(([id])=>selected.has(id));if(!chosen.length){result.textContent='Add at least one product before requesting a quote.';return}if(!name.value.trim()||(!phone.value.trim()&&!email.value.trim())){result.textContent='Enter your name plus a phone number or email.';return}const sum=chosen.reduce((a,[,p])=>a+p.price,0),ref='P4X4-A87-'+Date.now().toString(36).toUpperCase(),snapshot={ref,vehicle:'Ranger P703',items:chosen.map(([id,p])=>({id,sku:p.sku,name:p.name,price:p.price,requires:p.requires})),partsTotal:sum,installation:'quote-required',lead:{name:name.value.trim(),phone:phone.value.trim(),email:email.value.trim(),postcode:postcode.value.trim(),notes:notes.value.trim()}};localStorage.setItem('p4x4-a87-last-quote',JSON.stringify(snapshot));result.className='result good';result.textContent=`TEST QUOTE CAPTURED · ${ref} · $${sum.toLocaleString()} parts + installation quote.`};sync();
</script>
<script type="module">
import * as THREE from "three";import {GLTFLoader} from "three/addons/loaders/GLTFLoader.js";import {OrbitControls} from "three/addons/controls/OrbitControls.js";
const host=document.querySelector('#stage'),st=document.querySelector('#status'),scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(28,1,.05,100),renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;host.appendChild(renderer.domElement);camera.position.set(4.7,2.6,6.8);const controls=new OrbitControls(camera,renderer.domElement);controls.target.set(0,.9,0);controls.enablePan=false;controls.minDistance=4;controls.maxDistance=10;controls.update();scene.add(new THREE.HemisphereLight(0xffffff,0x182027,2.3));for(const [p,i] of [[[5,7,8],4],[[-5,4,4],2],[[0,6,-6],2.5]]){const l=new THREE.DirectionalLight(0xffffff,i);l.position.set(...p);scene.add(l)}const root=new THREE.Group();scene.add(root);const loader=new GLTFLoader();let factoryFront,factoryRear,pred,rally,lights,scout,powerboards,tubrack,rearbumper;
try{const [r,f,fr,p,h,l,s,pb,tr,rb]=await Promise.all([loader.loadAsync('ranger-static-front-rear.glb'),loader.loadAsync('factory-front.glb'),loader.loadAsync('factory-rear.glb'),loader.loadAsync('predator.glb'),loader.loadAsync('rally-hoop-v3.glb'),loader.loadAsync('butt-kicker-7-pair-v1.glb'),loader.loadAsync('scout.glb'),loader.loadAsync('powerboards.glb'),loader.loadAsync('tubrack.glb'),loader.loadAsync('rearbumper.glb')]);root.add(r.scene);factoryFront=f.scene;factoryRear=fr.scene;pred=p.scene;rally=h.scene;lights=l.scene;scout=s.scene;powerboards=pb.scene;tubrack=tr.scene;rearbumper=rb.scene;root.add(factoryFront,factoryRear,pred,rally,lights,scout,powerboards,tubrack,rearbumper);apply(JSON.parse(localStorage.getItem('p4x4-a87')||'[]'));st.textContent='READY · FRONT + REAR REPLACEMENT STATES';document.getElementById('runtimeGate').textContent='RUNTIME CHECK · 10/10 3D ASSETS LOADED'}catch(e){console.error(e);st.textContent='3D ASSET LOAD ERROR'}
function apply(ids){const s=new Set(ids);if(factoryFront)factoryFront.visible=!s.has('predator');if(pred)pred.visible=s.has('predator');if(rally)rally.visible=s.has('predator')&&s.has('rally');if(lights)lights.visible=s.has('predator')&&s.has('rally')&&s.has('lights');if(scout)scout.visible=s.has('scout');if(powerboards)powerboards.visible=s.has('powerboards');if(tubrack)tubrack.visible=s.has('tubrack');if(factoryRear)factoryRear.visible=!s.has('rearbumper');if(rearbumper)rearbumper.visible=s.has('rearbumper')}
window.addEventListener('rigchange',e=>apply(e.detail));window.addEventListener('resetview',()=>{camera.position.set(4.7,2.6,6.8);controls.target.set(0,.9,0);controls.update()});window.addEventListener('setview',e=>{camera.position.set(...(e.detail==='front'?[0,1.7,7.2]:[4.7,2.6,6.8]));controls.target.set(0,.9,0);controls.update()});function resize(){const w=host.clientWidth,h=host.clientHeight;camera.aspect=w/h;camera.updateProjectionMatrix();renderer.setSize(w,h,false)}new ResizeObserver(resize).observe(host);resize();renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera)});
</script></body></html>